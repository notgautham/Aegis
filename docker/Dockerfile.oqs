# ── Stage 1: Build Frontend ─────────────────────────────────────────
FROM node:22-alpine AS frontend-builder
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
RUN npm run build

# ── Stage 1b: Build Amass from source with a current Go toolchain ──
# The release binaries are built with an older Go and carry its stdlib CVEs.
FROM golang:1.26-alpine AS amass-builder
ARG AMASS_VERSION=5.1.1
RUN apk add --no-cache git && \
    git clone --depth 1 --branch v${AMASS_VERSION} https://github.com/owasp-amass/amass.git /src && \
    cd /src && \
    go get golang.org/x/crypto@latest golang.org/x/net@latest github.com/klauspost/compress@latest google.golang.org/grpc@latest && \
    go mod tidy && \
    CGO_ENABLED=0 go build -trimpath -o /amass ./cmd/amass

# ─────────────────────────────────────────────────────────
# Stage 2: Aegis – PQC-Enabled Infrastructure (Alpine Native Build)
# ─────────────────────────────────────────────────────────

FROM python:3.11-alpine

# Install build and runtime dependencies
# Added openssl-dev to resolve CMake OpenSSL discovery issues
# Added gcompat for glibc compatibility (useful for Amass binaries)
RUN apk add --no-cache \
    ca-certificates \
    nmap \
    wget \
    sed \
    openssl \
    openssl-dev \
    libssl3 \
    libffi-dev \
    build-base \
    samurai \
    cmake \
    git \
    python3-dev \
    linux-headers \
    autoconf \
    libtool \
    pkgconf \
    gcompat

# Pull in Alpine security patches released after the base image was built
RUN apk upgrade --no-cache

# samurai provides samu, we symlink it to ninja for CMake compatibility
RUN ln -sf /usr/bin/samu /usr/local/bin/ninja

WORKDIR /tmp

# Build liboqs from source inside the final image to ensure linking compatibility
# Explicitly setting OPENSSL_ROOT_DIR to /usr for Alpine compatibility
RUN git clone --depth 1 https://github.com/open-quantum-safe/liboqs.git && \
    cd liboqs && mkdir build && cd build && \
    cmake -GNinja \
          -DBUILD_SHARED_LIBS=ON \
          -DCMAKE_INSTALL_PREFIX=/usr/local \
          -DOPENSSL_ROOT_DIR=/usr .. && \
    ninja && ninja install

# Build OQS provider for OpenSSL 3.x
RUN git clone --depth 1 --branch main https://github.com/open-quantum-safe/oqs-provider.git && \
    cd oqs-provider && mkdir build && cd build && \
    cmake -GNinja \
          -Dliboqs_DIR=/usr/local \
          -DCMAKE_INSTALL_PREFIX=/usr/local \
          -DOPENSSL_ROOT_DIR=/usr .. && \
    ninja && ninja install && \
    ln -sf $(find /usr/local -name oqsprovider.so) /usr/local/lib/oqsprovider.so

# Ensure the system uses the OQS-patched OpenSSL
RUN ln -sf /usr/bin/openssl /usr/local/bin/openssl-oqs

# Create a clean OpenSSL config that activates both default and oqs providers
RUN mkdir -p /usr/local/ssl && \
    echo "openssl_conf = openssl_init" > /usr/local/ssl/openssl.cnf && \
    echo "" >> /usr/local/ssl/openssl.cnf && \
    echo "[openssl_init]" >> /usr/local/ssl/openssl.cnf && \
    echo "providers = provider_sect" >> /usr/local/ssl/openssl.cnf && \
    echo "" >> /usr/local/ssl/openssl.cnf && \
    echo "[provider_sect]" >> /usr/local/ssl/openssl.cnf && \
    echo "default = default_sect" >> /usr/local/ssl/openssl.cnf && \
    echo "oqs = oqs_sect" >> /usr/local/ssl/openssl.cnf && \
    echo "" >> /usr/local/ssl/openssl.cnf && \
    echo "[default_sect]" >> /usr/local/ssl/openssl.cnf && \
    echo "activate = 1" >> /usr/local/ssl/openssl.cnf && \
    echo "" >> /usr/local/ssl/openssl.cnf && \
    echo "[oqs_sect]" >> /usr/local/ssl/openssl.cnf && \
    echo "module = /usr/local/lib/oqsprovider.so" >> /usr/local/ssl/openssl.cnf && \
    echo "activate = 1" >> /usr/local/ssl/openssl.cnf

# Set up library paths
RUN ldconfig /usr/local/lib || true

COPY --from=amass-builder /amass /usr/local/bin/amass

WORKDIR /app

# Install Python dependencies (build tools still present for C extension compilation)
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir liboqs-python

# Remove build-only dependencies and source trees to reduce CVE surface
RUN apk del --no-cache \
    build-base \
    samurai \
    cmake \
    git \
    python3-dev \
    linux-headers \
    autoconf \
    libtool \
    pkgconf \
    openssl-dev \
    wget && \
    rm -rf /tmp/liboqs /tmp/oqs-provider

COPY . .
# Copy frontend dist from stage 1
COPY --from=frontend-builder /frontend/dist /app/frontend/dist

# Set OQS configuration at runtime
ENV LD_LIBRARY_PATH=/usr/local/lib
# liboqs-python cannot auto-discover liboqs once build tools are removed
ENV OQS_INSTALL_PATH=/usr/local
ENV OPENSSL_CONF=/usr/local/ssl/openssl.cnf

EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
